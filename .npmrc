# Still needed (checked 2026-10 with npm 10.9): without it npm installs peer
# dependencies, `npm ci` rejects package-lock.json as out of sync, and
# `npm install` adds ~130 packages, among them a standalone webpack 5 that the
# build plugins (@ducanh2912/next-pwa, workbox-webpack-plugin, the Sentry
# webpack plugin) list as a peer while Next builds with its own bundled copy.
# Dropping the flag means regenerating the lock and re-checking the PWA build
# against that second webpack.
legacy-peer-deps=true
