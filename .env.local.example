# ====================================
# Supabase Configuration
# ====================================
# Get these from: https://app.supabase.com/project/_/settings/api
# Your Supabase project URL (e.g., https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Your Supabase anon/public key (safe to use in browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# There is no service-role key here on purpose. The app talks to Supabase only
# from the browser under anon/authenticated, and nothing in the codebase reads
# SUPABASE_SERVICE_ROLE_KEY. A key that bypasses RLS should not sit in a file
# the app never opens.

# ====================================
# App Configuration
# ====================================
# Absolute URL of the app: used for metadata, OG images, robots.txt and the
# sitemap. Optional. Without it lib/site.ts uses NEXT_PUBLIC_VERCEL_URL — the
# deployment's own domain, a system variable Vercel sets on every build (keep
# "Automatically expose System Environment Variables" on) — and outside Vercel
# it falls back to https://killerpool.app, not to localhost. Invite links and
# QR codes do not depend on it: they use the browser's own origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production URL (use in Vercel environment variables)
# NEXT_PUBLIC_APP_URL=https://killerpool.app

# ====================================
# Sentry (optional)
# ====================================
# Public DSN. Safe in the browser bundle. Sentry reports only from a Vercel
# deployment: it needs NODE_ENV === 'production' AND Vercel's environment
# (NEXT_PUBLIC_VERCEL_ENV in the browser, VERCEL_ENV on the server) to be
# 'production' or 'preview', which also becomes the event's environment tag.
# So `npm run dev` and a local `npm run build && npm run start` stay silent
# even with the DSN set here.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>

# Build-time only, never shipped to the client: uploads source maps so stack
# traces are readable. Without it the build still succeeds — map upload is
# simply skipped (next.config.js: sourcemaps.disable). Create one at
# https://sentry.io/settings/account/api/auth-tokens/ with project:releases.
# Set it in Vercel, not here.
# SENTRY_AUTH_TOKEN=
